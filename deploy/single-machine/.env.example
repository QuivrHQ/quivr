# setup.py init generates secrets in .env (0600). Do not commit it.
COMPOSE_PROJECT_NAME=quivr
QUIVR_EMBEDDING=gemma
# QUIVR_MODEL_REVISION is recorded by setup.py from the release; preserve it.
QUIVR_ORGANIZATION=quivr
QUIVR_INFRASTRUCTURE_PROFILE=small
QUIVR_OFFLINE=0
# Gemma and e5 are initial installation choices. Existing cache identity is fixed.
QUIVR_EMBEDDING_THREADS=4
QUIVR_EMBEDDING_CPUS=4
QUIVR_EMBEDDING_MEMORY=4g
QUIVR_WORKER_LIVE_SLOTS=1
QUIVR_WORKER_BULK_SLOTS=1
QUIVR_API_PORT=8080
QUIVR_DEMO_PORT=3000
# Optional overrides in MiB; setup.py init re-renders limits and index GOMEMLIMIT.
# QUIVR_POSTGRES_MEMORY_MB=4096
# QUIVR_WEAVIATE_MEMORY_MB=12288
# Generated/read from 0600 files: QUIVR_DB_PASSWORD, QUIVR_API_KEY,
# QUIVR_OPERATOR_KEY, QUIVR_CURSOR_KEY, QUIVR_CREDENTIAL_KEY, S3_ACCESS_KEY,
# S3_SECRET_KEY, EMBED_API_KEY, DEMO_PASSWORD (64 hexadecimal characters each).
